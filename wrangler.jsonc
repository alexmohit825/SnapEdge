{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapedge",
  "main": "src/worker/ingestion.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
